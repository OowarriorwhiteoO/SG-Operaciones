@model SistemaGestion.Application.DTOs.EntradaDetalleDto
@{ ViewData["Title"] = "Detalle de entrada"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="mb-0">@Model.DocumentoOrigen</h1><span class="text-muted">@Model.Tipo · @Model.UnidadMedida</span></div>
<div>@if ((User.IsInRole("Administrador") || User.IsInRole("Bodega")) && Model.SaldoDisponible > 0){<a class="btn btn-primary" asp-controller="Asignaciones" asp-action="Crear" asp-route-entradaId="@Model.Id">Crear asignación</a> <a class="btn btn-outline-warning" asp-controller="Mermas" asp-action="Crear" asp-route-entradaId="@Model.Id">Registrar merma</a>} @if(Model.Estado.ToString()=="Vigente"&&(User.IsInRole("Administrador")||User.IsInRole("Supervisor"))){<a class="btn btn-outline-danger" asp-controller="Anulaciones" asp-action="Crear" asp-route-clase="Entrada" asp-route-id="@Model.Id">Anular entrada</a>}</div></div>
<div class="row g-3 mb-4">
<div class="col-sm-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><small class="text-muted">Cantidad inicial</small><div class="h3">@Model.CantidadInicial.ToString("N3")</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><small class="text-muted">Asignado vigente</small><div class="h3">@Model.TotalAsignado.ToString("N3")</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card h-100 shadow-sm"><div class="card-body"><small class="text-muted">Merma vigente</small><div class="h3">@Model.TotalMerma.ToString("N3")</div></div></div></div>
<div class="col-sm-6 col-lg-3"><div class="card h-100 border-success shadow-sm"><div class="card-body"><small class="text-muted">Saldo disponible</small><div class="h3 text-success">@Model.SaldoDisponible.ToString("N3")</div></div></div></div>
</div>
<div class="card shadow-sm mb-4"><div class="card-header fw-semibold">Datos de la entrada</div><div class="card-body row g-3"><div class="col-md-4"><strong>Fecha</strong><br/>@Model.FechaHora.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</div><div class="col-md-4"><strong>Estado</strong><br/>@Model.Estado</div><div class="col-md-4"><strong>Responsable</strong><br/>@Model.UsuarioResponsable</div><div class="col-12"><strong>Observación</strong><br/>@(Model.Observacion ?? "Sin observación")</div></div></div>
<h2 class="h4">Asignaciones relacionadas</h2>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Trabajador</th><th class="text-end">Cantidad</th><th>Estado</th></tr></thead><tbody>
@if(Model.Asignaciones.Count==0){<tr><td colspan="4" class="text-center text-muted py-4">Esta entrada aún no tiene asignaciones.</td></tr>}
@foreach(var x in Model.Asignaciones){<tr><td>@x.FechaHora.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td><td>@x.Trabajador</td><td class="text-end">@x.Cantidad.ToString("N3") @x.UnidadMedida</td><td>@x.Estado</td><td>@if(x.Estado.ToString()=="Vigente"&&(User.IsInRole("Administrador")||User.IsInRole("Supervisor"))){<a class="btn btn-sm btn-outline-danger" asp-controller="Anulaciones" asp-action="Crear" asp-route-clase="Asignacion" asp-route-id="@x.Id">Anular</a>}</td></tr>}</tbody></table></div>
<h2 class="h4 mt-4">Mermas relacionadas</h2>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Motivo</th><th>Evidencia</th><th class="text-end">Cantidad</th><th>Estado</th><th></th></tr></thead><tbody>
@if(Model.Mermas.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">Esta entrada aún no tiene mermas.</td></tr>}
@foreach(var x in Model.Mermas){<tr><td>@x.FechaHora.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td><td>@x.Motivo</td><td>@(x.EvidenciaReferencia??"—")</td><td class="text-end">@x.Cantidad.ToString("N3") @x.UnidadMedida</td><td>@x.Estado</td><td>@if(x.Estado.ToString()=="Vigente"&&(User.IsInRole("Administrador")||User.IsInRole("Supervisor"))){<a class="btn btn-sm btn-outline-danger" asp-controller="Anulaciones" asp-action="Crear" asp-route-clase="Merma" asp-route-id="@x.Id">Anular</a>}</td></tr>}</tbody></table></div>
