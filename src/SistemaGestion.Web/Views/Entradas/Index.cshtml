@model SistemaGestion.Web.Models.EntradaIndexViewModel
@{ ViewData["Title"] = "Entradas"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="mb-0">Entradas</h1><small class="text-muted">Recepciones y saldo disponible</small></div>
    @if (User.IsInRole("Administrador") || User.IsInRole("Bodega")) { <a class="btn btn-primary" asp-action="Crear">Nueva entrada</a> }
</div>
<form method="get" class="card card-body shadow-sm mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-lg-2"><label asp-for="Filtro.FechaDesde" class="form-label"></label><input asp-for="Filtro.FechaDesde" name="FechaDesde" class="form-control"/></div>
        <div class="col-sm-6 col-lg-2"><label asp-for="Filtro.FechaHasta" class="form-label"></label><input asp-for="Filtro.FechaHasta" name="FechaHasta" class="form-control"/></div>
        <div class="col-lg-3"><label class="form-label">Tipo</label><select name="TipoRegistroId" class="form-select"><option value="">Todos</option>@foreach(var tipo in Model.Tipos){<option value="@tipo.Id" selected="@(Model.Filtro.TipoRegistroId == tipo.Id)">@tipo.Nombre</option>}</select></div>
        <div class="col-lg-3"><label class="form-label">Documento</label><input name="DocumentoOrigen" value="@Model.Filtro.DocumentoOrigen" class="form-control"/></div>
        <div class="col-lg-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div>
    </div>
</form>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table table-hover align-middle mb-0">
<thead><tr><th>Fecha</th><th>Documento</th><th>Tipo</th><th class="text-end">Inicial</th><th class="text-end">Asignado</th><th class="text-end">Merma</th><th class="text-end">Saldo</th><th></th></tr></thead>
<tbody>
@if(Model.Resultado.Items.Count == 0){<tr><td colspan="8" class="text-center text-muted py-5">No existen entradas para los filtros seleccionados.</td></tr>}
@foreach(var x in Model.Resultado.Items){<tr><td>@x.FechaHora.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td><td class="fw-semibold">@x.DocumentoOrigen</td><td>@x.Tipo <small class="text-muted">(@x.UnidadMedida)</small></td><td class="text-end">@x.CantidadInicial.ToString("N3")</td><td class="text-end">@x.TotalAsignado.ToString("N3")</td><td class="text-end">@x.TotalMerma.ToString("N3")</td><td class="text-end fw-bold @(x.SaldoDisponible == 0 ? "text-secondary" : "text-success")">@x.SaldoDisponible.ToString("N3")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@x.Id">Detalle</a></td></tr>}
</tbody></table></div>
@if(Model.Resultado.TotalPages > 1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(var p=1;p<=Model.Resultado.TotalPages;p++){<li class="page-item @(p==Model.Resultado.PageNumber?"active":"")"><a class="page-link" asp-route-Pagina="@p" asp-route-FechaDesde="@Model.Filtro.FechaDesde?.ToString("yyyy-MM-dd")" asp-route-FechaHasta="@Model.Filtro.FechaHasta?.ToString("yyyy-MM-dd")" asp-route-TipoRegistroId="@Model.Filtro.TipoRegistroId" asp-route-DocumentoOrigen="@Model.Filtro.DocumentoOrigen">@p</a></li>}</ul></nav>}

