@model SistemaGestion.Application.DTOs.AdministracionDashboardDto
@{ ViewData["Title"] = "Administración"; var moneda = (await ComercialGlobal.ObtenerEmpresaAsync(Context.RequestAborted)).Moneda; }

<div class="page-heading">
    <div><span class="eyebrow">CONFIGURACIÓN GENERAL</span><h1>Panel de administración</h1><p>Gestiona la empresa, las personas y el ciclo comercial desde un solo lugar.</p></div>
    <a class="btn btn-primary" asp-action="Empresa"><span class="material-symbols-outlined">edit</span> Datos de empresa</a>
</div>

<section class="kpi-grid admin-kpi-grid" aria-label="Resumen administrativo">
    <article class="kpi-card" title="Trabajadores activos registrados en el catálogo de trabajadores">
        <small>Trabajadores activos</small><span class="kpi-icon blue"><span class="material-symbols-outlined">badge</span></span>
        <strong>@Model.Trabajadores</strong><em>@Model.Usuarios usuario(s) activo(s) con acceso</em>
    </article>
    <article class="kpi-card" title="Cotizaciones enviadas o aceptadas que todavía no han sido facturadas">
        <small>Cotizaciones abiertas</small><span class="kpi-icon violet"><span class="material-symbols-outlined">request_quote</span></span>
        <strong>@Model.CotizacionesPendientes</strong><em>@Model.CotizacionesMonto.ComoMoneda(moneda) en oportunidades</em>
    </article>
    <article class="kpi-card" title="Facturas internas emitidas que aún no registran pago">
        <small>Facturas por cobrar</small><span class="kpi-icon amber"><span class="material-symbols-outlined">payments</span></span>
        <strong>@Model.FacturasPendientes</strong><em>@Model.PorCobrar.ComoMoneda(moneda) pendiente</em>
    </article>
    <article class="kpi-card" title="Total de facturas internas vigentes emitidas durante el mes actual">
        <small>Facturación del mes</small><span class="kpi-icon green"><span class="material-symbols-outlined">monitoring</span></span>
        <strong>@Model.FacturadoMes.ComoMoneda(moneda)</strong><em>Documentos internos vigentes</em>
    </article>
</section>

<details class="metric-source-note mb-4">
    <summary><span class="material-symbols-outlined">info</span> ¿Cómo se calculan estos indicadores?</summary>
    <div>
        <p><strong>Trabajadores:</strong> registros activos del catálogo. <strong>Usuarios:</strong> cuentas activas con acceso al sistema.</p>
        <p><strong>Cotizaciones abiertas:</strong> documentos enviados o aceptados; el monto corresponde a la suma de sus totales.</p>
        <p><strong>Por cobrar:</strong> facturas internas emitidas sin pago. <strong>Facturación mensual:</strong> facturas vigentes emitidas desde el primer día del mes actual.</p>
    </div>
</details>

<section class="app-panel">
    <div class="panel-heading"><div><h2>Aplicaciones de @Model.Empresa</h2><p>Accesos para administrar los datos maestros y las operaciones comerciales.</p></div></div>
    <div class="admin-modules">
        <a class="admin-module" asp-action="Empresa"><span class="module-icon blue"><span class="material-symbols-outlined">domain</span></span><strong>Empresa</strong><small>Identidad, contacto, dirección e impuestos</small></a>
        <a class="admin-module" asp-controller="Trabajadores" asp-action="Index"><span class="module-icon violet"><span class="material-symbols-outlined">badge</span></span><strong>Trabajadores</strong><small>Ficha y estado del personal</small></a>
        <a class="admin-module" asp-controller="Usuarios" asp-action="Index"><span class="module-icon slate"><span class="material-symbols-outlined">manage_accounts</span></span><strong>Usuarios</strong><small>Acceso, roles y seguridad</small></a>
        <a class="admin-module" asp-controller="Clientes" asp-action="Index"><span class="module-icon cyan"><span class="material-symbols-outlined">groups</span></span><strong>Clientes</strong><small>@Model.Clientes clientes activos</small></a>
        <a class="admin-module" asp-controller="Productos" asp-action="Index"><span class="module-icon green"><span class="material-symbols-outlined">sell</span></span><strong>Productos y servicios</strong><small>@Model.Productos ítems disponibles</small></a>
        <a class="admin-module" asp-controller="Cotizaciones" asp-action="Index"><span class="module-icon orange"><span class="material-symbols-outlined">request_quote</span></span><strong>Cotizaciones</strong><small>Propuestas y seguimiento comercial</small></a>
        <a class="admin-module" asp-controller="Facturas" asp-action="Index"><span class="module-icon red"><span class="material-symbols-outlined">receipt_long</span></span><strong>Facturación</strong><small>Emisión interna y control de pagos</small></a>
        <a class="admin-module" asp-controller="Auditoria" asp-action="Index"><span class="module-icon slate"><span class="material-symbols-outlined">policy</span></span><strong>Auditoría</strong><small>Trazabilidad de acciones relevantes</small></a>
    </div>
</section>
