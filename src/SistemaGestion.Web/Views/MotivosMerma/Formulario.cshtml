@model SistemaGestion.Application.DTOs.MotivoMermaInput
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo motivo" : "Editar motivo"; }
<h1>@ViewData["Title"]</h1><form asp-action="Guardar" method="post" class="card card-body shadow-sm"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/></div><div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control"></textarea></div><div class="form-check"><input asp-for="RequiereEvidencia" class="form-check-input"/><label asp-for="RequiereEvidencia" class="form-check-label">Requiere evidencia</label></div><div class="form-check"><input asp-for="RequiereAutorizacion" class="form-check-input"/><label asp-for="RequiereAutorizacion" class="form-check-label">Requiere autorización</label></div><div class="mt-4"><button class="btn btn-primary">Guardar</button> <a class="btn btn-link" asp-action="Index">Cancelar</a></div></form>
