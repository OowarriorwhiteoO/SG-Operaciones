@model SistemaGestion.Web.Models.InformeTrabajadorViewModel
@{ ViewData["Title"] = "Informe por trabajador"; var f = Model.Filtro; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div><h1 class="mb-0">Informe por trabajador</h1><small class="text-muted">Asignaciones y documentos de origen relacionados</small></div>
    <a class="btn btn-outline-primary" asp-action="Index">Volver al consolidado</a>
</div>
<form method="get" class="card card-body shadow-sm mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label class="form-label">Trabajador</label><select class="form-select" name="TrabajadorId" required><option value="">Seleccione</option>@foreach(var x in Model.Trabajadores){<option value="@x.Id" selected="@(f.TrabajadorId==x.Id)">@x.NombreCompleto · @x.Rut</option>}</select></div>
        <div class="col-md-3"><label class="form-label">Desde</label><input class="form-control" type="date" name="FechaDesde" value="@f.FechaDesde.ToString("yyyy-MM-dd")"/></div>
        <div class="col-md-3"><label class="form-label">Hasta</label><input class="form-control" type="date" name="FechaHasta" value="@f.FechaHasta.ToString("yyyy-MM-dd")"/></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Generar</button></div>
        <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" name="IncluirAnuladas" value="true" checked="@f.IncluirAnuladas"/><label class="form-check-label">Incluir asignaciones anuladas</label></div></div>
    </div>
</form>
@if(Model.Informe is { } informe)
{
    <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
        <div><strong>@informe.Trabajador</strong><div class="text-muted">@informe.Rut · @informe.Area · @informe.Estado</div></div>
        <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="ExportarTrabajador" asp-route-formato="csv" asp-route-TrabajadorId="@f.TrabajadorId" asp-route-FechaDesde="@f.FechaDesde.ToString("yyyy-MM-dd")" asp-route-FechaHasta="@f.FechaHasta.ToString("yyyy-MM-dd")" asp-route-IncluirAnuladas="@f.IncluirAnuladas">CSV</a><a class="btn btn-primary" asp-action="ExportarTrabajador" asp-route-formato="pdf" asp-route-TrabajadorId="@f.TrabajadorId" asp-route-FechaDesde="@f.FechaDesde.ToString("yyyy-MM-dd")" asp-route-FechaHasta="@f.FechaHasta.ToString("yyyy-MM-dd")" asp-route-IncluirAnuladas="@f.IncluirAnuladas">PDF</a></div>
    </div>
    <div class="row g-3 mb-4">@foreach(var x in informe.Subtotales){<div class="col-md-4"><div class="card h-100 shadow-sm"><div class="card-body"><small class="text-muted">@x.Tipo</small><div class="h4 mb-0">@x.Cantidad.ToString("N3") @x.UnidadMedida</div></div></div></div>}</div>
    <div class="table-responsive bg-white rounded shadow-sm"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Entrada</th><th>Documento</th><th>Tipo</th><th class="text-end">Cantidad</th><th>Estado</th></tr></thead><tbody>@foreach(var x in informe.Items){<tr><td>@x.FechaHora.ToLocalTime().ToString("g")</td><td>#@x.EntradaId</td><td>@x.DocumentoOrigen</td><td>@x.Tipo</td><td class="text-end">@x.Cantidad.ToString("N3") @x.UnidadMedida</td><td>@x.Estado</td></tr>}</tbody></table></div>
}
else
{
    <div class="card shadow-sm"><div class="card-body text-center text-muted py-5"><span class="material-symbols-outlined fs-1">person_search</span><p class="mb-0">Seleccione un trabajador y genere el informe.</p></div></div>
}
