@model IReadOnlyList<SistemaGestion.Application.DTOs.TrabajadorDto>
@{ ViewData["Title"] = "Trabajadores"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Trabajadores</h1><a class="btn btn-primary" asp-action="Crear">Nuevo trabajador</a></div>
<div class="table-responsive bg-white shadow-sm rounded"><table class="table table-hover mb-0">
<thead><tr><th>RUT</th><th>Nombre</th><th>Área</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
<tbody>@foreach (var x in Model) { <tr><td>@x.Rut</td><td>@x.NombreCompleto</td><td>@x.Area</td><td><span class="badge bg-@(x.Estado.ToString()=="Activo" ? "success" : "secondary")">@x.Estado</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@x.Id">Editar</a> <form class="d-inline" asp-action="CambiarEstado" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="activar" value="@(x.Estado.ToString()!="Activo" ? "true" : "false")"/><button class="btn btn-sm btn-outline-secondary">@(x.Estado.ToString()=="Activo" ? "Desactivar" : "Activar")</button></form></td></tr> }</tbody>
</table></div>
