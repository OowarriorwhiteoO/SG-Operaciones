@model SistemaGestion.Application.DTOs.FacturaDetalleDto
@{ Layout = null; var moneda = (await ComercialGlobal.ObtenerEmpresaAsync(Context.RequestAborted)).Moneda; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>@Model.Numero</title><style>
body{font:14px Arial,sans-serif;color:#152238;margin:40px}.head{display:flex;justify-content:space-between;border-bottom:2px solid #1769c2;padding-bottom:18px}.muted{color:#65758b}.notice{margin:20px 0;padding:12px;background:#fff7dc;border:1px solid #e8bd3d}table{width:100%;border-collapse:collapse;margin-top:24px}th,td{padding:10px;border-bottom:1px solid #d8dee8;text-align:left}.right{text-align:right}.totals{margin:25px 0 0 auto;width:300px}.totals div{display:flex;justify-content:space-between;padding:7px}.total{font-size:20px;font-weight:bold;border-top:2px solid #1769c2}@@media print{button{display:none}body{margin:15mm}}
</style></head><body><div class="head"><div><h1>Factura interna</h1><strong>@Model.Numero</strong><p class="muted">Emisión: @Model.FechaEmision.ToString("dd-MM-yyyy")</p></div><div class="right"><h2>@Model.Cliente</h2><p>@Model.ClienteRut<br/>@Model.ClienteEmail</p></div></div><div class="notice">Documento comercial interno. No constituye factura electrónica ni DTE autorizado por el SII.</div><table><thead><tr><th>Código</th><th>Descripción</th><th class="right">Cantidad</th><th class="right">Precio</th><th class="right">Total</th></tr></thead><tbody>@foreach(var x in Model.Lineas){<tr><td>@x.Codigo</td><td>@x.Descripcion</td><td class="right">@x.Cantidad.ToString("N2") @x.Unidad</td><td class="right">@x.PrecioUnitario.ComoMoneda(moneda)</td><td class="right">@x.Total.ComoMoneda(moneda)</td></tr>}</tbody></table><div class="totals"><div><span>Neto</span><strong>@Model.Neto.ComoMoneda(moneda)</strong></div><div><span>IVA</span><strong>@Model.Iva.ComoMoneda(moneda)</strong></div><div class="total"><span>Total</span><strong>@Model.Total.ComoMoneda(moneda)</strong></div></div><button onclick="window.print()">Imprimir</button></body></html>
