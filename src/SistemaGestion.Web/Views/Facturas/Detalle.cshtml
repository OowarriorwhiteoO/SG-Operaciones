@model SistemaGestion.Application.DTOs.FacturaDetalleDto
@using SistemaGestion.Domain.Enums
@{ ViewData["Title"] = Model.Numero; }
<div class="page-heading"><div><span class="eyebrow">FACTURA INTERNA</span><h1>@Model.Numero</h1><p>Origen: @Model.CotizacionNumero · vence el @Model.FechaVencimiento.ToString("dd-MM-yyyy")</p></div><div class="heading-actions"><a class="btn btn-outline-primary" asp-action="Imprimir" asp-route-id="@Model.Id" target="_blank"><span class="material-symbols-outlined">print</span> Imprimir</a></div></div>
<div class="internal-document-note"><span class="material-symbols-outlined">info</span><span>Documento comercial interno. No constituye factura electrónica ni DTE autorizado por el SII.</span></div>
<article class="app-panel document-sheet">
<div class="document-header"><div><span class="document-label">Cliente</span><h2>@Model.Cliente</h2><p>@Model.ClienteRut<br/>@(Model.ClienteEmail ?? "Sin correo registrado")</p></div><span class="status-pill status-@Model.Estado.ToString().ToLowerInvariant()">@Model.Estado</span></div>
<div class="table-responsive"><table class="table app-table"><thead><tr><th>Código</th><th>Descripción</th><th class="text-end">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Neto</th><th class="text-end">Total</th></tr></thead><tbody>@foreach (var x in Model.Lineas) { <tr><td>@x.Codigo</td><td>@x.Descripcion</td><td class="text-end">@x.Cantidad.ToString("N2") @x.Unidad</td><td class="text-end">@x.PrecioUnitario.ToString("C0")</td><td class="text-end">@x.Neto.ToString("C0")</td><td class="text-end"><strong>@x.Total.ToString("C0")</strong></td></tr> }</tbody></table></div>
<div class="document-bottom"><div>@if (Model.Estado == EstadoFactura.Emitida) { <form asp-action="MarcarPagada" method="post" class="payment-form"><input type="hidden" name="id" value="@Model.Id"/><div><label class="form-label" for="fechaPago">Fecha de pago</label><input id="fechaPago" name="fechaPago" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div><label class="form-label" for="referencia">Referencia</label><input id="referencia" name="referencia" class="form-control" placeholder="Transferencia, comprobante..."/></div><button class="btn btn-primary">Registrar pago</button></form> } else if (Model.FechaPago.HasValue) { <p><strong>Pagada:</strong> @Model.FechaPago.Value.ToString("dd-MM-yyyy") · @(Model.ReferenciaPago ?? "Sin referencia")</p> }</div><dl class="document-summary"><div><dt>Neto</dt><dd>@Model.Neto.ToString("C0")</dd></div><div><dt>IVA</dt><dd>@Model.Iva.ToString("C0")</dd></div><div class="document-total"><dt>Total</dt><dd>@Model.Total.ToString("C0")</dd></div></dl></div>
</article>

