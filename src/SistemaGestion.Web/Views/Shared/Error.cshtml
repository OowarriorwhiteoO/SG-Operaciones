@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card text-center mx-auto" style="max-width:620px"><div class="card-body py-5">
    <span class="material-symbols-outlined text-danger" style="font-size:52px">error</span>
    <h1 class="mt-3">No pudimos completar la operación</h1>
    <p class="text-muted">@Model.Message</p>
    @if (Model.ShowRequestId){<p class="small">Código de soporte: <code>@Model.RequestId</code></p>}
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al panel</a>
</div></div>
