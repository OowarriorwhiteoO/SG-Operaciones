@model SistemaGestion.Web.Models.CotizacionCrearViewModel
@{ ViewData["Title"] = "Nueva cotización"; }
<div class="page-heading"><div><span class="eyebrow">VENTAS</span><h1>Nueva cotización</h1><p>Selecciona el cliente y agrega hasta seis productos o servicios.</p></div></div>
<form asp-action="Crear" method="post" class="app-panel form-panel">
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3 mb-4">
<div class="col-md-6"><label asp-for="Input.ClienteId" class="form-label"></label><select asp-for="Input.ClienteId" class="form-select"><option value="">Seleccionar cliente</option>@foreach (var x in Model.Clientes) { <option value="@x.Id">@x.RazonSocial · @x.Rut</option> }</select><span asp-validation-for="Input.ClienteId" class="text-danger"></span></div>
<div class="col-md-3"><label asp-for="Input.FechaEmision" class="form-label"></label><input asp-for="Input.FechaEmision" class="form-control"/></div><div class="col-md-3"><label asp-for="Input.FechaVencimiento" class="form-label"></label><input asp-for="Input.FechaVencimiento" class="form-control"/></div>
</div>
<h2 class="section-title">Detalle</h2>
<div class="table-responsive"><table class="table app-table quote-lines"><thead><tr><th>Producto o servicio</th><th style="width:150px">Cantidad</th><th style="width:160px">Descuento %</th></tr></thead><tbody>
@for (var i = 0; i < Model.Input.Lineas.Count; i++) { <tr><td><select asp-for="Input.Lineas[i].ProductoServicioId" class="form-select"><option value="0">Seleccionar ítem</option>@foreach (var p in Model.Productos) { <option value="@p.Id">@p.Codigo · @p.Nombre · @p.PrecioNeto.ToString("C0")</option> }</select></td><td><input asp-for="Input.Lineas[i].Cantidad" class="form-control" min="0" step="0.01"/></td><td><input asp-for="Input.Lineas[i].DescuentoPorcentaje" class="form-control" min="0" max="100" step="0.01"/></td></tr> }
</tbody></table></div>
<div><label asp-for="Input.Observacion" class="form-label"></label><textarea asp-for="Input.Observacion" class="form-control" rows="3" placeholder="Condiciones, alcance o comentarios para el cliente"></textarea></div>
<div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button class="btn btn-primary">Crear cotización</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

