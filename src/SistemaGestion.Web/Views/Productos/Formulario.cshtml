@model SistemaGestion.Application.DTOs.ProductoServicioInput
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo producto o servicio" : "Editar producto o servicio"; var moneda = (await ComercialGlobal.ObtenerEmpresaAsync(Context.RequestAborted)).Moneda; var simbolo = moneda == "USD" ? "US$" : moneda == "EUR" ? "€" : "$"; }
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO COMERCIAL</span><h1>@ViewData["Title"]</h1><p>Define el precio neto; el impuesto se calcula al crear la cotización.</p></div></div>
<form asp-action="Guardar" method="post" class="app-panel form-panel"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-3"><label asp-for="Codigo" class="form-label"></label><input asp-for="Codigo" class="form-control"/><span asp-validation-for="Codigo" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="col-md-3"><label asp-for="UnidadMedida" class="form-label"></label><input asp-for="UnidadMedida" class="form-control"/></div>
<div class="col-md-8"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="PrecioNeto" class="form-label"></label><div class="input-group"><span class="input-group-text">@simbolo</span><input asp-for="PrecioNeto" class="form-control"/></div><small class="form-text text-muted">Moneda global: @moneda</small><div class="form-check mt-3"><input asp-for="AfectoIva" class="form-check-input"/><label asp-for="AfectoIva" class="form-check-label"></label></div><div class="form-check"><input asp-for="EsServicio" class="form-check-input"/><label asp-for="EsServicio" class="form-check-label"></label></div></div>
</div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button class="btn btn-primary">Guardar ítem</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
