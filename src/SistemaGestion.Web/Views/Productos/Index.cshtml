@model IReadOnlyList<SistemaGestion.Application.DTOs.ProductoServicioDto>
@{ ViewData["Title"] = "Productos y servicios"; }
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO COMERCIAL</span><h1>Productos y servicios</h1><p>Precios base y tributación usados al cotizar.</p></div><a class="btn btn-primary" asp-action="Crear"><span class="material-symbols-outlined">add</span> Nuevo ítem</a></div>
<div class="app-panel table-responsive"><table class="table app-table mb-0"><thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Unidad</th><th class="text-end">Precio neto</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var x in Model) { <tr><td><strong>@x.Codigo</strong></td><td>@x.Nombre</td><td>@(x.EsServicio ? "Servicio" : "Producto")</td><td>@x.UnidadMedida</td><td class="text-end">@x.PrecioNeto.ToString("C0")</td><td><span class="status-pill @(x.Estado.ToString()=="Activo" ? "success" : "neutral")">@x.Estado</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@x.Id">Editar</a> <form class="d-inline" asp-action="CambiarEstado" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="activar" value="@(x.Estado.ToString()!="Activo" ? "true" : "false")"/><button class="btn btn-sm btn-outline-secondary">@(x.Estado.ToString()=="Activo" ? "Desactivar" : "Activar")</button></form></td></tr> }
</tbody></table></div>

