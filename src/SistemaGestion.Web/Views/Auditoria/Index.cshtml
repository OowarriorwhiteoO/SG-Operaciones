@model SistemaGestion.Application.Common.PagedResult<SistemaGestion.Application.DTOs.AuditoriaItemDto>
@{ ViewData["Title"]="Centro de Informes y Auditoría"; var q=Context.Request.Query; }
<section class="page-heading"><div><span class="eyebrow">Trazabilidad operativa</span><h1>Centro de Informes y Auditoría</h1><p>Registro inmutable de operaciones críticas y exportaciones.</p></div><a class="btn btn-primary" asp-controller="Reportes" asp-action="Index"><span class="material-symbols-outlined align-middle">summarize</span> Abrir informes</a></section>
<form method="get" class="card card-body mb-4 filter-panel"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3 align-items-end">
<div class="col-md-2"><label class="form-label">Desde</label><input type="date" name="FechaDesde" value="@q["FechaDesde"]" class="form-control"/></div><div class="col-md-2"><label class="form-label">Hasta</label><input type="date" name="FechaHasta" value="@q["FechaHasta"]" class="form-control"/></div>
<div class="col-md-2"><label class="form-label">Entidad</label><input name="Entidad" value="@q["Entidad"]" class="form-control"/></div><div class="col-md-2"><label class="form-label">Acción</label><input name="Accion" value="@q["Accion"]" class="form-control"/></div>
<div class="col-md-2"><label class="form-label">Usuario</label><input name="Usuario" value="@q["Usuario"]" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Aplicar búsqueda</button></div></div></form>
<div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Fecha / hora</th><th>Responsable</th><th>Acción</th><th>Entidad</th><th>Registro</th><th>Motivo</th><th>Correlation ID</th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="7" class="empty-state">No existen eventos para los filtros seleccionados.</td></tr>}
@foreach(var x in Model.Items){<tr><td class="fw-semibold">@x.FechaHora.ToLocalTime().ToString("dd-MM-yyyy HH:mm:ss")</td><td>@x.NombreUsuario</td><td><span class="status-badge info">@x.Accion</span></td><td>@x.Entidad</td><td>@x.ClavePrimaria</td><td>@x.Motivo</td><td><code class="small">@x.CorrelationId</code></td></tr>}
</tbody></table></div>
@if(Model.TotalPages>1){<nav class="mt-3"><ul class="pagination justify-content-center">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.PageNumber?"active":"")"><a class="page-link" asp-route-Pagina="@p" asp-route-FechaDesde="@q["FechaDesde"]" asp-route-FechaHasta="@q["FechaHasta"]" asp-route-Entidad="@q["Entidad"]" asp-route-Accion="@q["Accion"]" asp-route-Usuario="@q["Usuario"]">@p</a></li>}</ul></nav>}
